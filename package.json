{
  "name": "kk-garden-server",
  "version": "1.0.0",
  "description": "Kiryl Kartsialeu EN69783 diploma project server app",
  "author": "Kiryl Kartsialeu",
  "scripts": {
    "dev": "npm run env-validate && npm run check && tsx watch src/server.ts",
    "build": "npm run env-validate && npm run check && tsc && tsc-alias",
    "start": "npm run env-validate && npm run check && node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typescript": "tsc --noEmit",
    "check": "tsx scripts/check.ts",
    "env-validate": "tsx scripts/env-validate.ts",
    "test:auth-rate-limit": "tsx scripts/auth-rate-limit-smoke.ts",
    "test:avatar-storage": "tsx scripts/avatar-storage-smoke.ts",
    "test:avatar-image": "tsx scripts/avatar-image-smoke.ts",
    "test:avatar-upload": "tsx scripts/avatar-upload-smoke.ts",
    "test:avatar-finalize": "tsx scripts/avatar-finalize-smoke.ts",
    "test:avatar-owner": "tsx scripts/avatar-owner-smoke.ts",
    "test:pending-owner": "tsx scripts/pending-owner-smoke.ts",
    "signature-key-pair": "tsx scripts/signature-key-pair.ts",
    "shared": "npm install @kk-garden/shared@latest"
  },
  "type": "module",
  "simple-git-hooks": {
    "pre-commit": "npm run check && npm run env-validate && git add ."
  },
  "overrides": {
    "mongodb": "$mongodb"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "4.0.3",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@better-auth/passkey": "^1.7.5",
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^11.2.0",
    "@kk-garden/shared": "^1.5.1",
    "agenda": "6.2.6",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^7.3.0",
    "mongoose": "^9.7.1",
    "rate-limiter-flexible": "11.2.3",
    "resend": "^6.28.1",
    "sharp": "^0.35.5",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "chalk": "^5.6.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "ora": "^9.4.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
